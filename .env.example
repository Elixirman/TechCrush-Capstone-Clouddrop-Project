# Flask
SECRET_KEY=change-me
FLASK_ENV=development

# RDS PostgreSQL (Member C)
DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/clouddrop

# S3 (Member B) — no access keys here; EC2 uses an IAM role instead
S3_BUCKET_NAME=clouddrop-files-bucket
AWS_REGION=us-east-1

# File sharing links (Member D)
SHARE_LINK_EXPIRY_MINUTES=60
